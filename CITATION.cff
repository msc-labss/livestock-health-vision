    family-names: Çakır
    affiliation: MSC Labs
repository-code: "https://github.com/msc-labss/livestock-health-vision"
url: "https://msclabs.tr"
license: AGPL-3.0-or-later
version: 0.1.0
date-released: 2026-09-19
keywords:
  - computer vision
  - precision livestock farming
  - dairy cattle
  - lameness detection
  - pose estimation
